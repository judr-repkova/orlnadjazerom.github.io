# Hlavičky pre Cloudflare Pages (iné hostingy tento súbor ignorujú)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Oznamy (dovolenka) sa musia prejaviť hneď
/assets/js/nastavenia.js
  Cache-Control: no-cache

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Testovacia adresa *.pages.dev sa nemá objaviť vo vyhľadávaní – hlavná je vlastná doména
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
